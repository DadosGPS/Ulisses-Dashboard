# Copia para .env e preenche com os valores reais do teu projeto Supabase.
# NUNCA commitar o .env real (já está no .gitignore da raiz do repo).

# Project Settings → Database → Connection string (URI) — usa a ligação
# "Connection pooling" se disponível, com o utilizador postgres/service-role.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Project Settings → API → API Keys ("Project URL")
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Domínio(s) do frontend Next.js autorizados a chamar esta API (separados por vírgula)
CORS_ORIGINS=http://localhost:3000

# Assistente de IA (Claude) — cria a chave em console.anthropic.com → API Keys.
# Sem esta chave, a página /assistente abre mas responde que não está configurada.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo usado pela assistente (por omissão claude-haiku-4-5).
# Alternativas: claude-sonnet-5 / claude-opus-5 para respostas mais elaboradas.
ANTHROPIC_MODEL=claude-haiku-4-5
